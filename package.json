{
  "name": "@crego/ui-kit",
  "version": "1.2.2",
  "description": "Shared UI components and utilities for Crego applications",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./tailwind-plugin": {
      "types": "./src/tailwind-plugin.d.ts",
      "require": "./src/tailwind-plugin.js"
    }
  },
  "files": [
    "dist",
    "src/tailwind-plugin.js",
    "src/tailwind-plugin.d.ts"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf dist node_modules"
  },
  "peerDependencies": {
    "@radix-ui/react-popover": ">=1.0.0",
    "@radix-ui/react-slot": ">=1.0.0",
    "lucide-react": "^0.462.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.26.2"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^1.14.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "tsup": "^8.0.0",
    "typescript": "^5.5.3"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "crego"
  ],
  "author": "Crego",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/crego-tech/crego-ui-kit.git"
  },
  "bugs": {
    "url": "https://github.com/crego-tech/crego-ui-kit/issues"
  },
  "homepage": "https://github.com/crego-tech/crego-ui-kit#readme"
}
